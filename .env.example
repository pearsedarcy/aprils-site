# =============================================================================
# Environment Variables for Wagtail Site
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------
# Generate a secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# Comma-separated list of CSRF trusted origins (must include https://)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Base URL for Wagtail admin (used in notification emails)
WAGTAILADMIN_BASE_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (development):
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (Docker Compose - uses 'db' service name):
DATABASE_URL=postgres://wagtail:changeme@db:5432/wagtail

# PostgreSQL password for Docker Compose (must match DATABASE_URL password)
POSTGRES_PASSWORD=changeme

# For external PostgreSQL (Hetzner managed, etc.):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# -----------------------------------------------------------------------------
# Cloudinary Media Storage
# -----------------------------------------------------------------------------
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Alternative format (if using CLOUDINARY_URL):
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# For Zoho (as configured in production.py):
# EMAIL_HOST=smtp.zoho.eu
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True

# -----------------------------------------------------------------------------
# Optional: PostgreSQL password (if using docker-compose PostgreSQL)
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD=your-secure-password
